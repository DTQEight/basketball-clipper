training/feat_traj/
training/features.jsonl

# 视频文件（太大）
*.mp4
*.avi
*.mov
*.mkv
*.ts
*.flv

# 权重文件（太大，用 release 上传）
weights/*.pt
*.pt

# 本地模型快照目录（训练前/训练后留档，含大权重；只留本地，不进仓库）
training/_model_backup_*/
training/_model_trained_*/
training/backup/
training/*.bak
# YOLO 裁剪数据集（由 build_yolo_crop_dataset.py 生成，可重建）
training/yolo_crop_data*/

# 缓存目录（项目根目录下的 cache/，内含 detection_history.json、preview 片段、输出缓存）
cache/
.cache/
*.cache

# 临时工作目录（本地曾把项目放在 basketball-clipper/ 子目录下，远端是扁平结构，应忽略）
basketball-clipper/

# IDE
.vscode/
.idea/
*.swp
*.swo

# 系统
.DS_Store
Thumbs.db
desktop.ini

# 日志
*.log
server.log

bug_report_*.txt

# 打包产物（PyInstaller 中间文件 / onedir 目录 / 单文件 exe / 安装包）
build/
dist/

# 导出的数据集（图像 + 清单 + 特征表，体积大）
dataset*/
